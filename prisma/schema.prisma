// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// NOTE: Local dev uses SQLite; enums are stored as String.
// ProductType: subscription | api_credit
// SubscriptionPlan: pro | max5x | max20x
// SubscriptionDuration: month | quarter | half_year | year
// OrderStatus: pending | paid | fulfilling | completed | refunded | cancelled
// PayChannel: usdt
// AdminRole: admin | operator

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  orders        Order[]

  @@map("users")
}

model Product {
  id           String    @id @default(cuid())
  type         String
  plan         String?
  duration     String?
  creditAmount Decimal?
  name         String
  priceUSD     Decimal
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  orders       Order[]

  @@map("products")
}

model Order {
  id               String        @id @default(cuid())
  orderNo          String        @unique
  userId           String?
  user             User?         @relation(fields: [userId], references: [id])
  productId        String
  product          Product       @relation(fields: [productId], references: [id])
  quantity         Int           @default(1)
  totalUSD         Decimal
  status           String        @default("pending")
  payChannel       String?
  tradeNo          String?
  paidAt           DateTime?
  contactEmail     String
  noteFromUser     String?
  activationLink   String?
  apiKey           String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  expiresAt        DateTime
  fulfillment      Fulfillment?

  @@index([userId])
  @@index([status])
  @@map("orders")
}

model Fulfillment {
  id               String    @id @default(cuid())
  orderId          String    @unique
  order            Order     @relation(fields: [orderId], references: [id])
  deliveredContent String
  operatorId       String
  operator         AdminUser @relation(fields: [operatorId], references: [id])
  deliveredAt      DateTime  @default(now())

  @@map("fulfillments")
}

model AdminUser {
  id           String        @id @default(cuid())
  username     String        @unique
  passwordHash String
  role         String        @default("operator")
  createdAt    DateTime      @default(now())
  fulfillments Fulfillment[]
  auditLogs    AuditLog[]

  @@map("admin_users")
}

model AuditLog {
  id         String    @id @default(cuid())
  adminId    String
  admin      AdminUser @relation(fields: [adminId], references: [id])
  action     String
  targetType String
  targetId   String
  createdAt  DateTime  @default(now())

  @@index([adminId])
  @@map("audit_logs")
}

model VerificationCode {
  id        String    @id @default(cuid())
  email     String
  purpose   String
  code      String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email, purpose])
  @@map("verification_codes")
}
